---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BookCard from '../../components/BookCard.astro';
import { slugify } from '../../lib/slug';

export async function getStaticPaths() {
  const books = await getCollection('books');
  const byAuthor = new Map<string, typeof books>();

  for (const book of books) {
    const author = book.data.author;
    const list = byAuthor.get(author) ?? [];
    list.push(book);
    byAuthor.set(author, list);
  }

  return [...byAuthor.entries()].map(([author, authorBooks]) => ({
    params: { author: slugify(author) },
    props: {
      author,
      books: authorBooks.sort((a, b) => {
        const da = a.data.publishedDate?.getTime() ?? 0;
        const db = b.data.publishedDate?.getTime() ?? 0;
        return db - da;
      }),
    },
  }));
}

interface Props {
  author: string;
  books: Awaited<ReturnType<typeof getCollection<'books'>>>;
}
const { author, books } = Astro.props;
---

<Layout title={`${author} の作品一覧 - 積み本、開く。`} description={`${author} のBLコミック作品一覧`}>
  <Header />
  <main class="w-full px-4 py-8 sm:px-6 lg:px-10">
    <a href="/" class="mb-6 inline-block text-xs text-inkdim underline decoration-line underline-offset-4 hover:text-gold">
      ← 本棚に戻る
    </a>

    <h1 class="font-display text-2xl text-ink sm:text-3xl">{author}</h1>
    <p class="mt-1 text-sm text-inkdim">{books.length} 冊を収蔵</p>

    <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 md:grid-cols-4 lg:grid-cols-5 lg:gap-6 xl:grid-cols-6 2xl:grid-cols-7">
      {books.map((book) => (
        <li>
          <BookCard book={book} />
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</Layout>
