---
import { getCollection } from 'astro:content';
import Layout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookCard from '../components/BookCard.astro';

const books = (await getCollection('books')).sort((a, b) => {
  const da = a.data.publishedDate?.getTime() ?? 0;
  const db = b.data.publishedDate?.getTime() ?? 0;
  return db - da;
});

const allTags = [...new Set(books.flatMap((b) => b.data.tags))].sort((a, b) =>
  a.localeCompare(b, 'ja')
);
---

<Layout title="yaoi-palette - BL本棚ギャラリー">
  <Header count={books.length} showFilterToggle tags={allTags} />

  <main class="w-full px-4 py-8 sm:px-6 lg:px-10">
    {books.length === 0 ? (
      <p class="py-24 text-center text-inkdim">まだ本が登録されていません。</p>
    ) : (
      <ul
        id="book-grid"
        class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 md:grid-cols-4 lg:grid-cols-5 lg:gap-6 xl:grid-cols-6 2xl:grid-cols-7"
      >
        {books.map((book) => (
          <li>
            <BookCard book={book} />
          </li>
        ))}
      </ul>
    )}
    <p id="empty-state" class="hidden py-24 text-center text-inkdim">
      条件に合う本が見つかりませんでした。絞り込みを調整してください。
    </p>
  </main>

  <Footer />
</Layout>

<script>
  // 色・人数・タグはいずれも単一選択（ラジオボタン）方式。
  // 複数選択すると該当0件になりがちなため、1グループにつき1つだけ選べる。
  type FilterType = 'color' | 'people' | 'font' | 'tag';

  const active: Record<FilterType, string | null> = {
    color: null,
    people: null,
    font: null,
    tag: null,
  };

  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const cards = document.querySelectorAll<HTMLElement>('.book-card');
  const resultCount = document.getElementById('result-count');
  const emptyState = document.getElementById('empty-state');
  const grid = document.getElementById('book-grid');
  const clearBtn = document.getElementById('clear-filters');

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach((card) => {
      // mainColorは最大2色登録されているため、いずれか一致すればOK
      const cardColors = (card.dataset.color ?? '').split(',').filter(Boolean);
      const cardPeople = card.dataset.people ?? '';
      const cardFont = card.dataset.font ?? '';
      const cardTags = (card.dataset.tags ?? '').split(',').filter(Boolean);

      const colorOk = !active.color || cardColors.includes(active.color);
      const peopleOk = !active.people || cardPeople === active.people;
      const fontOk = !active.font || cardFont === active.font;
      const tagOk = !active.tag || cardTags.includes(active.tag);

      const visible = colorOk && peopleOk && fontOk && tagOk;
      const li = card.closest('li');
      if (li) li.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    });

    if (resultCount) resultCount.textContent = `${visibleCount}冊を表示中`;
    if (emptyState) emptyState.classList.toggle('hidden', visibleCount !== 0);
    if (grid) grid.classList.toggle('hidden', visibleCount === 0);
  }

  function setChipState(chip: HTMLButtonElement, checked: boolean) {
    chip.setAttribute('aria-checked', String(checked));
    chip.classList.toggle('border-wine', checked);
    chip.classList.toggle('text-ink', checked);
    chip.classList.toggle('bg-surface2', checked);
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const type = chip.dataset.filterType as FilterType | undefined;
      const value = chip.dataset.filterValue;
      if (!type || !value) return;

      const isActive = chip.getAttribute('aria-checked') === 'true';

      // 同じグループの他のチップは解除する（ラジオボタン挙動）
      chips.forEach((otherChip) => {
        if (otherChip.dataset.filterType === type && otherChip !== chip) {
          setChipState(otherChip, false);
        }
      });

      setChipState(chip, !isActive);
      active[type] = isActive ? null : value;
      applyFilters();

      // PCではチップを選んだらドロップダウンを閉じる（モバイルは常時展開なので無害）
      chip.closest('.dropdown-panel')?.classList.remove('open');
    });
  });

  clearBtn?.addEventListener('click', () => {
    (Object.keys(active) as FilterType[]).forEach((type) => { active[type] = null; });
    chips.forEach((chip) => setChipState(chip, false));
    applyFilters();
  });

  applyFilters();
</script>
