---
import type { CollectionEntry } from 'astro:content';
import { slugify } from '../lib/slug';

interface Props {
  book: CollectionEntry<'books'>;
}
const { book } = Astro.props;
const { title, author, coverUrl, mainColor, peopleCount, tags, fontStyle } = book.data;
const authorHref = `/authors/${slugify(author)}/`;
---

<div
  class="book-card group overflow-hidden rounded-xl border border-line bg-surface shadow-sm transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-lg hover:shadow-wine/10"
  data-color={mainColor.join(',')}
  data-people={peopleCount}
  data-font={fontStyle ?? ''}
  data-tags={tags.join(',')}
  data-title={title}
>
  <a href={`/books/${book.id}/`} class="block aspect-cover w-full overflow-hidden">
    <img
      src={coverUrl}
      alt={`『${title}』の表紙`}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.04]"
      width="450"
      height="600"
    />
  </a>

  <div class="p-2.5 sm:p-3">
    <a href={`/books/${book.id}/`} class="block">
      <p class="font-display text-sm leading-snug text-ink text-balance line-clamp-2">{title}</p>
    </a>
    <a
      href={authorHref}
      class="mt-1 inline-block text-xs text-inkdim hover:text-wine hover:underline"
    >
      {author}
    </a>
    {tags.length > 0 && (
      <ul class="mt-2 flex flex-wrap gap-1">
        {tags.slice(0, 3).map((tag) => (
          <li class="rounded-sm border border-line px-1.5 py-0.5 text-[10px] text-inkdim">{tag}</li>
        ))}
      </ul>
    )}
  </div>
</div>
