---
interface Props {
  href: string;
  price?: number;
}
const { href, price } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer sponsored"
  class="inline-flex items-center justify-center gap-2 rounded-sm bg-wine px-5 py-3 text-sm font-medium text-ink transition-colors hover:bg-wine/85"
>
  楽天Koboで見る
  {price !== undefined && <span class="text-inkdim/90">・{price.toLocaleString('ja-JP')}円〜</span>}
</a>
